---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="404, Page Not Found" description="Page not found">
  <Header />
  <main class="flex-1 flex items-center justify-center py-24 px-4 sm:px-6">
    <div class="text-center">
      <p class="text-sky-400 font-mono text-sm mb-4">404</p>
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Page not found</h1>
      <p class="text-slate-400 mb-8 max-w-sm mx-auto">
        This page doesn't exist or was moved.
      </p>
      <a
        href={base}
        class="px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-white font-medium rounded-lg transition-colors"
      >
        Back to home
      </a>
    </div>
  </main>
  <Footer />
</Layout>
