---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const skills = [
  {
    category: 'Infrastructure & Automation',
    icon: 'm6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z',
    label: 'Infrastructure & Automatisation',
    items: ['Ansible', 'Linux (Debian / RedHat)', 'Python', 'Bash', 'Git'],
  },
  {
    category: 'Networking',
    icon: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
    label: 'Réseau',
    items: ['OPNsense', 'VLANs & routage', 'WireGuard VPN', 'DHCP / DNS', 'Règles de pare-feu'],
  },
  {
    category: 'Containerization',
    icon: 'M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
    label: 'Conteneurisation',
    items: ['Docker', 'Docker Compose', 'Gestion de conteneurs', 'Sauvegardes de volumes'],
  },
  {
    category: 'Monitoring & Observability',
    icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z',
    label: 'Supervision & Observabilité',
    items: ['Grafana', 'InfluxDB', 'Telegraf', 'Graylog', 'Centreon', 'SNMP'],
  },
  {
    category: 'Storage & Backup',
    icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
    label: 'Stockage & Sauvegarde',
    items: ['Gestion NAS', 'Pipelines de sauvegarde automatisés', 'Synology', 'OpenMediaVault'],
  },
  {
    category: 'Security',
    icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
    label: 'Sécurité',
    items: ['Gestion des certificats SSL/TLS', 'Déploiement de clés SSH', 'Isolation réseau', 'Vaultwarden'],
  },
];

const jobs = [
  {
    period: '2024 – Présent',
    title: 'Ingénieur Infrastructure',
    company: 'Davidson',
    description: "Poste d'ingénierie infrastructure axé sur la conception, le déploiement et l'automatisation de solutions d'infrastructure.",
  },
  {
    period: '2020 – 2024',
    title: 'Ingénieur Infrastructure',
    company: 'SII',
    description: "Poste d'ingénierie infrastructure couvrant l'administration système, l'automatisation et la gestion d'infrastructure.",
  },
];
---

<Layout title="À propos" description="À propos de moi — ingénieur infrastructure" lang="fr">
  <Header lang="fr" />
  <main class="flex-1 py-12 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Bio -->
      <section class="mb-16">
        <div class="flex flex-col sm:flex-row gap-8 items-start">
          <div
            class="w-24 h-24 rounded-full bg-slate-800 border-2 border-slate-700 flex items-center justify-center flex-shrink-0 text-4xl"
          >
            👤
          </div>
          <div>
            <h1 class="text-3xl font-bold text-slate-100 mb-1">Joffrey Birster</h1>
            <p class="text-sky-400 font-medium mb-5">Ingénieur Infrastructure</p>
            <div class="text-slate-400 leading-relaxed space-y-3 text-base">
              <p>
                Je suis passionné par l'infrastructure, Linux et les réseaux. J'ai construit mon infrastructure pour qu'elle soit aussi sécurisée que possible, avec de vrais serveurs, des pare-feux, du stockage, de la segmentation réseau et bien plus. Récemment, j'ai mis toute la configuration possible sous forme de code Ansible.
              </p>
              <p>
                N'hésitez pas à parcourir le site pour en savoir plus sur ce que je fais sur mon infrastructure. Si vous le souhaitez, vous pouvez me contacter sur LinkedIn.
              </p>
            </div>
            <div class="flex flex-wrap gap-3 mt-6">
              <a
                href="https://github.com/joffrey-b/"
                class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-sm font-medium rounded-lg transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
              </a>
              <a
                href="https://www.linkedin.com/in/joffrey-birster/"
                class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-sm font-medium rounded-lg transition-colors"
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Career timeline -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-slate-100 mb-8">Parcours</h2>
        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-slate-700"></div>
          <div class="space-y-6">
            {
              jobs.map((job) => (
                <div class="pl-12 relative">
                  <div class="absolute left-0 w-8 h-8 rounded-full bg-slate-900 border-2 border-sky-500 flex items-center justify-center">
                    <div class="w-2 h-2 bg-sky-400 rounded-full" />
                  </div>
                  <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
                    <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                      <h3 class="text-slate-100 font-semibold">{job.title}</h3>
                      <span class="text-xs text-slate-500 font-mono">{job.period}</span>
                    </div>
                    <p class="text-sky-400 text-sm font-medium mb-2">{job.company}</p>
                    <p class="text-slate-400 text-sm leading-relaxed">{job.description}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Skills -->
      <section>
        <h2 class="text-2xl font-bold text-slate-100 mb-6">Compétences Techniques</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            skills.map((group) => (
              <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d={group.icon} />
                  </svg>
                  <h3 class="text-slate-100 font-semibold">{group.label}</h3>
                </div>
                <div class="flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span class="text-xs bg-slate-900/80 text-slate-300 border border-slate-700 px-2.5 py-1 rounded-md font-mono">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
