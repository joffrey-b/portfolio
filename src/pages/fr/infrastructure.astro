---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const infraItems = await getCollection('infrastructure-fr');
const hardware = infraItems
  .filter((i) => i.data.type === 'hardware')
  .sort((a, b) => a.data.order - b.data.order);
const coreServices = infraItems
  .filter((i) => i.data.type === 'service' && i.data.group === 'core')
  .sort((a, b) => a.data.order - b.data.order);
const appServices = infraItems
  .filter((i) => i.data.type === 'service' && i.data.group === 'app')
  .sort((a, b) => a.data.order - b.data.order);

const appCategoryOrder = ['Infrastructure & Networking', 'Monitoring & Observability', 'Security', 'Media', 'Productivity & Tools'];
const appCategoryLabels: Record<string, string> = {
  'Infrastructure & Networking': 'Infrastructure & Réseau',
  'Monitoring & Observability': 'Supervision & Observabilité',
  Security: 'Sécurité',
  Media: 'Médias',
  'Productivity & Tools': 'Productivité & Outils',
};
const appsByCategory = appCategoryOrder.map((category) => ({
  category,
  label: appCategoryLabels[category],
  items: appServices.filter((s) => s.data.category === category),
}));

const practices = [
  {
    title: 'Tout en tant que Code',
    icon: 'M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5',
    desc: "Toute la configuration de l'infrastructure est gérée via des rôles Ansible idempotents et versionnés. Les changements sont prévisualisés avec --check avant d'être appliqués.",
  },
  {
    title: 'Double Stratégie de Sauvegarde',
    icon: 'M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z',
    desc: 'Les services critiques sont sauvegardés à la fois sur un NAS Synology et une VM OpenMediaVault hébergée sur Proxmox. Les sauvegardes sont automatisées et planifiées.',
  },
  {
    title: 'Isolation Réseau',
    icon: 'M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z',
    desc: 'Les VLANs sont isolés les uns des autres, sauf pour le traffic autorisé explicitement. Les règles de pare-feu sont appliquées via OPNsense avec un déploiement automatisé et idempotent.',
  },
  {
    title: 'Observabilité Complète',
    icon: 'M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178ZM15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
    desc: 'Tableaux de bord Grafana pour les métriques, Graylog pour les journaux centralisés, Centreon pour les contrôles de services. Chaque hôte est supervisé.',
  },
];
---

<Layout
  title="Infrastructure"
  description="Vue d'ensemble de l'infrastructure : réseau, serveurs et services"
  lang="fr"
>
  <Header lang="fr" />
  <main class="flex-1 py-12 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10">
        <h1 class="text-3xl font-bold text-slate-100 mb-3">Vue d'ensemble de l'Infrastructure</h1>
        <p class="text-slate-400 text-lg max-w-3xl">
          Une infrastructure de production avec segmentation réseau multi-VLAN, un stack de supervision
          complet, des services conteneurisés et des sauvegardes automatisées. Chaque composant
          est géré en tant que code avec Ansible.
        </p>
      </div>

      <!-- Physical Hardware -->
      <section id="physical-hardware" class="mb-12">
        <h2 class="text-xl font-bold text-slate-100 mb-4">Matériel Physique</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            hardware.map((h) => (
              <a
                href={`${import.meta.env.BASE_URL}fr/infrastructure/${h.slug}`}
                class="group block bg-slate-800 border border-slate-700 rounded-xl p-5 hover:border-sky-500/50 hover:bg-slate-800/80 transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-2 mb-3">
                  <div>
                    <h3 class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors">{h.data.name}</h3>
                    <p class="text-sky-400 text-sm font-medium">{h.data.subtitle}</p>
                  </div>
                </div>
                <ul class="mb-3 space-y-0.5">
                  {h.data.specs.map((s) => (
                    <li class="text-slate-400 text-xs font-mono">{s}</li>
                  ))}
                </ul>
                <p class="text-slate-400 text-sm leading-relaxed">{h.data.description}</p>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Architecture diagram -->
      <section class="mb-12">
        <h2 class="text-xl font-bold text-slate-100 mb-4">Architecture</h2>
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6">

          <!-- Internet → Routeur FAI → OPNsense -->
          <div class="mb-4 flex flex-col items-start gap-1">
            <div class="flex items-center gap-2">
              <span class="font-mono text-sm font-semibold text-sky-400">Internet</span>
            </div>
            <span class="ml-1 text-slate-600 text-xs">↓</span>
            <div class="flex items-center gap-2">
              <span class="font-mono text-sm font-semibold text-sky-400">Routeur FAI</span>
              <span class="text-slate-300 text-sm">WAN</span>
            </div>
            <span class="ml-1 text-slate-600 text-xs">↓</span>
            <div class="inline-flex flex-wrap items-baseline gap-x-3 bg-sky-500/10 border border-sky-500/20 rounded-lg px-4 py-2.5">
              <span class="text-sky-300 font-semibold">Pare-feu OPNsense</span>
              <span class="text-slate-400 text-sm">Routage multi-VLAN · Kea DHCP · Unbound DNS · WireGuard VPN</span>
            </div>
          </div>

          <!-- Branches -->
          <div class="ml-4 pl-5 border-l-2 border-slate-600 space-y-2.5">

            <!-- VLAN 10 -->
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 10</span>
              <span class="text-slate-300 text-sm">Management</span>
              <span class="text-slate-500 text-xs">Interfaces web (Centreon, Grafana, Graylog, Proxmox…) · accès SSH</span>
            </div>

            <!-- VLAN 12 -->
            <div>
              <div class="flex flex-wrap items-baseline gap-x-2 mb-2">
                <span class="font-mono text-sm font-semibold text-sky-400">VLAN 12</span>
                <span class="text-slate-300 text-sm">Serveurs</span>
                <span class="text-slate-500 text-xs">Infrastructure de production</span>
              </div>
              <div class="ml-4 pl-5 border-l-2 border-slate-700 space-y-2">

                <!-- Proxmox -->
                <div>
                  <div class="flex flex-wrap items-baseline gap-x-2 mb-1.5">
                    <span class="text-slate-200 text-sm font-medium">Proxmox VE</span>
                    <span class="text-slate-500 text-xs">Hyperviseur · héberge toutes les VMs ci-dessous</span>
                  </div>
                  <div class="ml-4 pl-5 border-l-2 border-slate-700/50 space-y-1.5">
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">Grafana</span>
                      <span class="text-slate-500 text-xs">Tableaux de bord métriques (InfluxDB + Telegraf)</span>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">Centreon</span>
                      <span class="text-slate-500 text-xs">Serveur de supervision système</span>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">Graylog + Datanode</span>
                      <span class="text-slate-500 text-xs">Centralisation des journaux (2 VMs)</span>
                    </div>

                    <!-- Docker VM -->
                    <div>
                      <div class="flex flex-wrap items-baseline gap-x-2 mb-1.5">
                        <span class="text-slate-300 text-sm">Docker</span>
                        <span class="text-slate-500 text-xs">Services conteneurisés derrière Nginx Proxy Manager</span>
                      </div>
                      <div class="ml-4 pl-4 border-l-2 border-slate-700/30 flex flex-wrap gap-1.5 py-1">
                        {['2FAuth','ARA','BentoPDF','DokuWiki','GitLab','Glance','IT-Tools','Joplin','Koito','Maloja','MariaDB','Mealie','Navidrome','Nextcloud','Nginx Proxy Manager','phpIPAM','Portainer','PostgreSQL','Vaultwarden'].map(s => (
                          <span class="text-xs text-slate-400 bg-slate-700/50 px-2 py-0.5 rounded">{s}</span>
                        ))}
                      </div>
                    </div>

                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">Frigate</span>
                      <span class="text-slate-500 text-xs">NVR / gestion des caméras IP</span>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">OpenMediaVault</span>
                      <span class="text-slate-500 text-xs">Stockage NAS secondaire</span>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-slate-300 text-sm">Serveurs de test</span>
                      <span class="text-slate-500 text-xs">Environnements de test Debian et RedHat</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Remaining VLANs -->
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 14</span>
              <span class="text-slate-300 text-sm">Ordinateurs</span>
              <span class="text-slate-500 text-xs">Ordinateurs fixes et machines de développement</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 16</span>
              <span class="text-slate-300 text-sm">WiFi de confiance</span>
              <span class="text-slate-500 text-xs">Appareils sans fil personnels</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 18</span>
              <span class="text-slate-300 text-sm">WiFi invité</span>
              <span class="text-slate-500 text-xs">WiFi invité isolé · isolation des clients au niveau du point d'accès</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 20</span>
              <span class="text-slate-300 text-sm">CCTV</span>
              <span class="text-slate-500 text-xs">Réseau caméras isolé → Frigate</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">VLAN 22</span>
              <span class="text-slate-300 text-sm">Ethernet invité</span>
              <span class="text-slate-500 text-xs">Ethernet invité isolé · isolation des clients au niveau du switch</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span class="font-mono text-sm font-semibold text-sky-400">WireGuard</span>
              <span class="text-slate-300 text-sm">VPN</span>
              <span class="text-slate-500 text-xs">Accès distant sécurisé</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Servers -->
      <section class="mb-12">
        <h2 class="text-xl font-bold text-slate-100 mb-4">Inventaire de l'infrastructure</h2>

        <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Infrastructure principale</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
          {
            coreServices.map((server) => (
              <a
                href={`${import.meta.env.BASE_URL}fr/infrastructure/${server.slug}`}
                class="group block bg-slate-800 border border-slate-700 rounded-xl p-5 hover:border-sky-500/50 hover:bg-slate-800/80 transition-all duration-200 hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d={server.data.icon} />
                    </svg>
                    <h3 class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors">{server.data.name}</h3>
                  </div>
                  <span class="text-xs text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded font-mono whitespace-nowrap flex-shrink-0">
                    {server.data.subtitle}
                  </span>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed">{server.data.description}</p>
              </a>
            ))
          }
        </div>

        <h3 id="self-hosted-applications" class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Applications auto-hébergées</h3>
        {
          appsByCategory.map(({ label, items }) => (
            <div class="mb-6 last:mb-0">
              <h4 class="text-xs font-semibold text-sky-400/80 uppercase tracking-wider mb-2.5">{label}</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {
                  items.map((server) => (
                    <a
                      href={`${import.meta.env.BASE_URL}fr/infrastructure/${server.slug}`}
                      class="group block bg-slate-800 border border-slate-700 rounded-xl p-5 hover:border-sky-500/50 hover:bg-slate-800/80 transition-all duration-200 hover:-translate-y-0.5"
                    >
                      <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="flex items-center gap-2">
                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d={server.data.icon} />
                          </svg>
                          <h3 class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors">{server.data.name}</h3>
                        </div>
                        <span class="text-xs text-sky-400 bg-sky-500/10 px-2 py-0.5 rounded font-mono whitespace-nowrap flex-shrink-0">
                          {server.data.subtitle}
                        </span>
                      </div>
                      <p class="text-slate-400 text-sm leading-relaxed">{server.data.description}</p>
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
      </section>

      <!-- Key Practices -->
      <section>
        <h2 class="text-xl font-bold text-slate-100 mb-4">Bonnes Pratiques</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            practices.map((item) => (
              <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-2">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                  <h3 class="text-slate-100 font-semibold">{item.title}</h3>
                </div>
                <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
