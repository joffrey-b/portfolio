---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allRoles = await getCollection('roles');

const categoryCounts = allRoles.reduce(
  (acc, role) => {
    const cat = role.data.category;
    acc[cat] = (acc[cat] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

const categories = Object.entries(categoryCounts);

const techStack = [
  'Ansible',
  'Docker',
  'OPNsense',
  'Grafana',
  'InfluxDB',
  'Telegraf',
  'Graylog',
  'OpenSearch',
  'MongoDB',
  'Centreon',
  'Proxmox',
  'ZoneMinder',
  'Nginx Proxy Manager',
  'Nextcloud',
  'GitLab',
  'Vaultwarden',
  'phpIPAM',
  'Portainer',
  'ARA',
  'WireGuard',
  'Unbound DNS',
  'Kea DHCP',
];
---

<Layout title="Home">
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <section class="relative py-24 px-4 sm:px-6 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-sky-500/5 via-transparent to-purple-500/5 pointer-events-none"
      >
      </div>
      <div class="max-w-4xl mx-auto text-center relative">
        <div
          class="inline-flex items-center gap-2 bg-slate-800 border border-slate-700 rounded-full px-4 py-1.5 text-sm text-slate-400 mb-8"
        >
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          Homelab operational
        </div>
        <h1 class="text-5xl sm:text-6xl font-bold text-slate-100 mb-4 tracking-tight">
          [Joffrey Birster]
        </h1>
        <p class="text-xl text-sky-400 font-medium mb-4">Infrastructure Engineer</p>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto leading-relaxed mb-8">
          Building and automating a production homelab with 50+ Ansible roles,
          spanning network management, containerized services, monitoring, and backup systems.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a
            href={`${import.meta.env.BASE_URL}roles`}
            class="px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-white font-medium rounded-lg transition-colors"
          >
            Browse Roles
          </a>
          <a
            href={`${import.meta.env.BASE_URL}infrastructure`}
            class="px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-white font-medium rounded-lg transition-colors"
          >
            Infrastructure
          </a>
          <a
            href={`${import.meta.env.BASE_URL}about`}
            class="px-5 py-2.5 bg-sky-500 hover:bg-sky-400 text-white font-medium rounded-lg transition-colors"
          >
            About Me
          </a>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-y border-slate-800 bg-slate-800/30 py-8 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold text-sky-400">50+</div>
          <div class="text-sm text-slate-400 mt-1">Ansible Roles</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-sky-400">14</div>
          <div class="text-sm text-slate-400 mt-1">Managed Hosts</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-sky-400">8</div>
          <div class="text-sm text-slate-400 mt-1">Network VLANs</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-sky-400">{categories.length}</div>
          <div class="text-sm text-slate-400 mt-1">Categories</div>
        </div>
      </div>
    </section>

    <!-- Homelab Overview -->
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-100 mb-2">My Homelab</h2>
        <p class="text-slate-400 mb-8 max-w-3xl">
          A production-grade home infrastructure built on dedicated hardware — network-segmented,
          fully monitored, and automated end to end with Ansible. Every component is managed as
          code: deploy, backup, and restore.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Network & Security</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              OPNsense firewall at the core with 8 VLANs isolating servers, desktops, cameras,
              and guests. Strict inter-VLAN rules, WireGuard VPN for remote access, Kea DHCP and
              Unbound DNS — all managed via REST API.
            </p>
          </div>
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Virtualization server</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              HP Z440 workstation running Proxmox VE with a Xeon E5-2698v3 and 128GB DDR4. Hosts
              10+ VMs: monitoring stack, logging, Docker services, cameras, a Windows gaming VM
              with PCI passthrough, a Linux dev VM, and test servers.
            </p>
          </div>
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Storage & Backup</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              Synology DS418 with 4×3TB as the primary NAS. A dedicated Proxmox Backup Server runs
              nightly encrypted VM backups. An OpenMediaVault VM acts as a secondary redundant target.
              All backup jobs are automated and managed as code.
            </p>
          </div>
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Monitoring & Observability</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              Grafana dashboards fed by InfluxDB and Telegraf agents on every host. Centreon
              handles service checks and sends email alerts via Postfix. Graylog aggregates logs
              from all servers using rsyslog.
            </p>
          </div>
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Services</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              A Docker VM hosts 15+ services: Vaultwarden (passwords), Nextcloud (file sync),
              GitLab, Navidrome (music), Joplin (notes), Mealie (recipes), DokuWiki, 2FAuth,
              and more — all behind Nginx Proxy Manager with SSL. ZoneMinder handles IP cameras
              on an isolated VLAN.
            </p>
          </div>
          <div class="bg-slate-800 border border-slate-700 rounded-xl p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-sky-400 flex-shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
              </svg>
              <h3 class="text-slate-100 font-semibold">Automation</h3>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              50+ Ansible roles cover the entire infrastructure: firewall rules,
              DHCP/DNS, certificates, monitoring agents, Docker deployments, and backup pipelines.
              Every role is idempotent and uses the code as source of truth.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-slate-800 pt-8">
          <a
            href={`${import.meta.env.BASE_URL}infrastructure`}
            class="group bg-slate-800/50 border border-slate-700 hover:border-sky-500/50 rounded-xl p-5 transition-all duration-200 hover:-translate-y-0.5"
          >
            <h3 class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors mb-1">
              Hardware & Network details
            </h3>
            <p class="text-slate-500 text-sm">
              Machine specs, VLAN topology, and full infrastructure overview.
            </p>
          </a>
          <a
            href={`${import.meta.env.BASE_URL}roles`}
            class="group bg-slate-800/50 border border-slate-700 hover:border-sky-500/50 rounded-xl p-5 transition-all duration-200 hover:-translate-y-0.5"
          >
            <h3 class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors mb-1">
              Ansible Roles
            </h3>
            <p class="text-slate-500 text-sm">
              50+ roles across {categories.length} categories — browse the full automation library.
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="py-16 px-4 sm:px-6 bg-slate-800/20 border-y border-slate-800">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-100 mb-2">Technologies & Tools</h2>
        <p class="text-slate-400 mb-8">The stack powering the homelab infrastructure.</p>
        <div class="flex flex-wrap gap-3">
          {
            techStack.map((tech) => (
              <span class="bg-slate-800 border border-slate-700 text-slate-300 px-4 py-2 rounded-lg text-sm font-medium">
                {tech}
              </span>
            ))
          }
          <span class="bg-slate-800/50 border border-slate-700/50 text-slate-500 px-4 py-2 rounded-lg text-sm font-medium italic">
            and more…
          </span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
