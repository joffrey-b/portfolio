---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RoleCard from '../../components/RoleCard.astro';
import { getCollection } from 'astro:content';

const allRoles = await getCollection('roles');
const sortedRoles = allRoles.sort((a, b) => a.data.title.localeCompare(b.data.title));
const categoryNames = [...new Set(allRoles.map((r) => r.data.category))].sort();
const categoryCounts = Object.fromEntries(
  categoryNames.map((cat) => [cat, allRoles.filter((r) => r.data.category === cat).length]),
);
const categories = ['All', ...categoryNames];
---

<Layout title="Ansible Roles" description="Browse all Ansible roles in the homelab infrastructure">
  <Header />
  <main class="flex-1 py-12 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-100 mb-2">Ansible Roles</h1>
        <p class="text-slate-400">
          50+ roles automating every aspect of the homelab infrastructure.
        </p>
      </div>

      <!-- Search -->
      <div class="mb-6">
        <input
          id="search"
          type="search"
          placeholder="Search roles..."
          class="w-full sm:w-96 bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-500/50 transition-colors"
        />
      </div>

      <!-- Category filter tabs -->
      <div class="flex flex-wrap gap-2 mb-8">
        {
          categories.map((cat) => (
            <button
              class="category-filter px-3 py-1.5 rounded-lg text-sm font-medium border transition-colors bg-slate-800 border-slate-700 text-slate-400 hover:text-slate-200 hover:border-slate-600 flex items-center gap-1.5"
              data-filter={cat}
            >
              {cat}
              <span class="text-xs opacity-60 font-mono">
                {cat === 'All' ? allRoles.length : categoryCounts[cat]}
              </span>
            </button>
          ))
        }
      </div>

      <!-- Role grid -->
      <div id="roles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          sortedRoles.map((role) => (
            <div
              class="role-item"
              data-category={role.data.category}
              data-title={role.data.title.toLowerCase()}
              data-desc={role.data.description.toLowerCase()}
              data-tags={role.data.tags.map((t) => t.toLowerCase()).join(' ')}
            >
              <RoleCard role={role} />
            </div>
          ))
        }
      </div>

      <!-- No results message -->
      <div id="no-results" class="hidden text-center py-16">
        <p class="text-slate-500 text-lg">No roles match your filter.</p>
        <button
          id="reset-filter"
          class="mt-3 text-sky-400 hover:text-sky-300 text-sm transition-colors"
        >
          Clear filter
        </button>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  let activeCategory = 'All';

  const searchInput = document.getElementById('search') as HTMLInputElement | null;
  const items = document.querySelectorAll<HTMLElement>('.role-item');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filter');

  function setActiveButton(cat: string) {
    filterButtons.forEach((btn) => {
      const isActive = btn.dataset.filter === cat;
      btn.classList.toggle('bg-sky-500/10', isActive);
      btn.classList.toggle('border-sky-500/30', isActive);
      btn.classList.toggle('text-sky-400', isActive);
      btn.classList.toggle('bg-slate-800', !isActive);
      btn.classList.toggle('border-slate-700', !isActive);
      btn.classList.toggle('text-slate-400', !isActive);
    });
  }

  function updateDisplay() {
    const query = searchInput?.value.toLowerCase() ?? '';
    let visibleCount = 0;

    items.forEach((item) => {
      const matchesCategory =
        activeCategory === 'All' || item.dataset.category === activeCategory;
      const matchesSearch =
        !query ||
        item.dataset.title?.includes(query) ||
        item.dataset.desc?.includes(query) ||
        item.dataset.tags?.includes(query);
      const show = matchesCategory && matchesSearch;
      item.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    noResults?.classList.toggle('hidden', visibleCount > 0);
  }

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.filter ?? 'All';
      setActiveButton(activeCategory);
      updateDisplay();
    });
  });

  searchInput?.addEventListener('input', updateDisplay);

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'All';
    if (searchInput) searchInput.value = '';
    setActiveButton('All');
    updateDisplay();
  });

  // Apply category from URL param (e.g. /roles?category=Applications)
  const params = new URLSearchParams(window.location.search);
  const urlCategory = params.get('category');
  if (urlCategory) {
    const btn = document.querySelector<HTMLButtonElement>(`[data-filter="${urlCategory}"]`);
    if (btn) btn.click();
  } else {
    setActiveButton('All');
  }
</script>
