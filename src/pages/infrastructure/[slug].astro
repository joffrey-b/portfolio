---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ScreenshotPlaceholder from '../../components/ScreenshotPlaceholder.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('infrastructure');
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { name, type, subtitle, description, specs, icon, screenshots, relatedRoles } = item.data;
const { Content } = await item.render();

const allRoles = await getCollection('roles');
const related = allRoles.filter((r) => relatedRoles.includes(r.slug));

const typeLabel = type === 'hardware' ? 'Hardware' : 'Service';
---

<Layout title={name} description={description}>
  <Header />
  <main class="flex-1 py-12 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-8 flex-wrap">
        <a href={`${import.meta.env.BASE_URL}infrastructure`} class="hover:text-slate-300 transition-colors">Infrastructure</a>
        <span>›</span>
        <span class="inline-flex items-center rounded-full font-medium bg-slate-500/20 text-slate-300 ring-1 ring-slate-500/30 text-xs px-2.5 py-1">
          {typeLabel}
        </span>
        <span>›</span>
        <span class="text-slate-300">{name}</span>
      </nav>

      <div class="lg:flex gap-10">
        <!-- Main content -->
        <div class="flex-1 min-w-0">
          <div class="mb-6">
            <div class="flex items-start gap-3 mb-2">
              {icon && (
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-sky-400 flex-shrink-0 mt-1">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                </svg>
              )}
              <div>
                <h1 class="text-3xl font-bold text-slate-100">{name}</h1>
                <p class="text-sky-400 font-medium">{subtitle}</p>
              </div>
            </div>
            <p class="text-slate-400 text-lg leading-relaxed mt-3">{description}</p>
          </div>

          {specs.length > 0 && (
            <div class="mb-6 bg-slate-800 border border-slate-700 rounded-xl p-5">
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">Specs</h3>
              <ul class="space-y-1">
                {specs.map((s: string) => (
                  <li class="text-slate-300 text-sm font-mono">{s}</li>
                ))}
              </ul>
            </div>
          )}

          <div
            class="prose prose-invert prose-slate max-w-none mb-10
            prose-headings:text-slate-100 prose-headings:font-bold
            prose-p:text-slate-300 prose-p:leading-relaxed
            prose-a:text-sky-400 prose-a:no-underline hover:prose-a:underline
            prose-code:text-sky-300 prose-code:bg-slate-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
            prose-strong:text-slate-200"
          >
            <Content />
          </div>

          {screenshots.length > 0 && (
            <section>
              <h2 class="text-lg font-bold text-slate-100 mb-4">Screenshots</h2>
              <ScreenshotPlaceholder screenshots={screenshots} />
            </section>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="lg:w-60 flex-shrink-0 mt-10 lg:mt-0">
          <div class="lg:sticky lg:top-24">
            {related.length > 0 && (
              <>
                <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">
                  Related Roles
                </h3>
                <div class="space-y-2">
                  {related.map((role) => (
                    <a
                      href={`${import.meta.env.BASE_URL}roles/${role.slug}`}
                      class="block bg-slate-800 border border-slate-700 rounded-lg p-3 hover:border-sky-500/50 transition-colors"
                    >
                      <p class="text-slate-200 text-sm font-medium hover:text-sky-400 transition-colors">
                        {role.data.title}
                      </p>
                      <p class="text-slate-500 text-xs mt-0.5 line-clamp-1">
                        {role.data.description}
                      </p>
                    </a>
                  ))}
                </div>
              </>
            )}
            <a
              href={`${import.meta.env.BASE_URL}infrastructure`}
              class:list={["block text-center text-sm text-sky-400 hover:text-sky-300 transition-colors", related.length > 0 ? "mt-5" : ""]}
            >
              ← All infrastructure
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
