---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  role: CollectionEntry<'roles'> | CollectionEntry<'roles-fr'>;
  lang?: string;
  hrefBase?: string;
}

const { role, lang = 'en', hrefBase = `${import.meta.env.BASE_URL}roles/` } = Astro.props;
const { title, category, description, tags } = role.data;
---

<a
  href={`${hrefBase}${role.slug}`}
  class="group block bg-slate-800 border border-slate-700 rounded-xl p-5 hover:border-sky-500/50 hover:bg-slate-800/80 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-sky-500/5 h-full"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3
      class="text-slate-100 font-semibold group-hover:text-sky-400 transition-colors leading-snug"
    >
      {title}
    </h3>
    <div class="flex-shrink-0">
      <CategoryBadge category={category} size="sm" lang={lang} />
    </div>
  </div>
  <p class="text-slate-400 text-sm leading-relaxed line-clamp-2 mb-4">
    {description}
  </p>
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <span class="text-xs text-slate-500 bg-slate-900/50 px-2 py-0.5 rounded font-mono">
            {tag}
          </span>
        ))}
        {tags.length > 4 && (
          <span class="text-xs text-slate-600 px-2 py-0.5">+{tags.length - 4}</span>
        )}
      </div>
    )
  }
</a>
