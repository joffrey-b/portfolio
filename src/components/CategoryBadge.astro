---
interface Props {
  category: string;
  size?: 'sm' | 'md';
  lang?: string;
}

const { category, size = 'md', lang = 'en' } = Astro.props;

const colorMap: Record<string, string> = {
  'Firewall & Security': 'bg-red-500/20 text-red-300 ring-1 ring-red-500/30',
  'Monitoring & Metrics': 'bg-green-500/20 text-green-300 ring-1 ring-green-500/30',
  'Docker & Containers': 'bg-blue-500/20 text-blue-300 ring-1 ring-blue-500/30',
  'Network & Storage': 'bg-purple-500/20 text-purple-300 ring-1 ring-purple-500/30',
  'Backup & Recovery': 'bg-amber-500/20 text-amber-300 ring-1 ring-amber-500/30',
  'System Management': 'bg-slate-500/20 text-slate-300 ring-1 ring-slate-500/30',
  Applications: 'bg-pink-500/20 text-pink-300 ring-1 ring-pink-500/30',
};

const categoryTranslations: Record<string, string> = {
  'Backup & Recovery': 'Sauvegarde & Restauration',
  'Monitoring & Metrics': 'Supervision & Métriques',
  'System Management': 'Gestion Système',
  'Firewall & Security': 'Pare-feu & Sécurité',
  'Docker & Containers': 'Docker & Conteneurs',
  'Network & Storage': 'Réseau & Stockage',
  Applications: 'Applications',
};

const colors = colorMap[category] ?? 'bg-slate-500/20 text-slate-300 ring-1 ring-slate-500/30';
const sizeClass = size === 'sm' ? 'text-xs px-2 py-0.5' : 'text-xs px-2.5 py-1';
const displayName = lang === 'fr' ? (categoryTranslations[category] ?? category) : category;
---

<span class:list={['inline-flex items-center rounded-full font-medium', colors, sizeClass]}>
  {displayName}
</span>
