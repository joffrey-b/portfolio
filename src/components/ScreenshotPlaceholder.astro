---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Screenshot = {
  caption: string;
  image?: ImageMetadata;
};

interface Props {
  screenshots: Screenshot[];
  lang?: string;
}

const { screenshots, lang = 'en' } = Astro.props;
const comingSoonText = lang === 'fr' ? 'Capture à venir' : 'Screenshot coming soon';
const viewFullSizeText = lang === 'fr' ? 'Voir en taille réelle ⤢' : 'View full size ⤢';
const closeText = lang === 'fr' ? 'Fermer' : 'Close';

const resolved = await Promise.all(
  screenshots.map(async (s) => ({
    caption: s.caption,
    optimized: s.image ? await getImage({ src: s.image, format: 'webp' }) : null,
  })),
);
const hasRealImages = resolved.some((s) => s.optimized);
---

{
  resolved.length > 0 && (
    <>
      <div class:list={['grid grid-cols-1 gap-4 items-start', { 'sm:grid-cols-2': resolved.length > 1 }]}>
        {resolved.map((s) =>
          s.optimized ? (
            <figure class="rounded-xl overflow-hidden border border-slate-700 bg-slate-800">
              <button
                type="button"
                class="screenshot-trigger group relative block w-full aspect-video bg-slate-900 flex items-center justify-center cursor-zoom-in"
                data-src={s.optimized.src}
                data-alt={s.caption}
              >
                <img
                  src={s.optimized.src}
                  alt={s.caption}
                  width={s.optimized.attributes.width}
                  height={s.optimized.attributes.height}
                  loading="lazy"
                  decoding="async"
                  class="max-w-full max-h-full w-auto h-auto object-contain"
                />
                <span class="absolute bottom-2 right-2 bg-slate-900/80 text-slate-300 text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">
                  {viewFullSizeText}
                </span>
              </button>
              <figcaption class="text-slate-400 text-sm px-3 py-2">{s.caption}</figcaption>
            </figure>
          ) : (
            <div class="aspect-video rounded-xl border-2 border-dashed border-slate-700 bg-slate-800/50 flex flex-col items-center justify-center gap-2 p-4 text-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8 text-slate-600"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                />
              </svg>
              <p class="text-slate-500 text-sm font-medium">{s.caption}</p>
              <p class="text-slate-600 text-xs italic">{comingSoonText}</p>
            </div>
          ),
        )}
      </div>

      {hasRealImages && (
        <dialog class="screenshot-lightbox m-0 p-0 w-full h-full max-w-none max-h-none border-0 bg-transparent backdrop:bg-slate-950/90">
          <div class="w-full h-full flex items-center justify-center p-6 relative">
            <button
              type="button"
              class="screenshot-lightbox-close absolute top-4 right-4 w-10 h-10 flex items-center justify-center rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 text-xl leading-none transition-colors"
              aria-label={closeText}
            >
              ✕
            </button>
            <img class="screenshot-lightbox-img max-w-full max-h-full object-contain rounded-lg" src="" alt="" />
          </div>
        </dialog>
      )}
    </>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.screenshot-lightbox');
  const lightboxImg = dialog?.querySelector<HTMLImageElement>('.screenshot-lightbox-img');
  const closeBtn = dialog?.querySelector<HTMLButtonElement>('.screenshot-lightbox-close');

  document.querySelectorAll<HTMLButtonElement>('.screenshot-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !lightboxImg) return;
      lightboxImg.src = trigger.dataset.src ?? '';
      lightboxImg.alt = trigger.dataset.alt ?? '';
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
