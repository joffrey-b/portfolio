---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Screenshot = {
  caption: string;
  image?: ImageMetadata;
};

interface Props {
  screenshots: Screenshot[];
  lang?: string;
}

const { screenshots, lang = 'en' } = Astro.props;
const comingSoonText = lang === 'fr' ? 'Capture à venir' : 'Screenshot coming soon';
---

{
  screenshots.length > 0 && (
    <div class:list={['grid grid-cols-1 gap-4 items-start', { 'sm:grid-cols-2': screenshots.length > 1 }]}>
      {screenshots.map((s) =>
        s.image ? (
          <figure class="rounded-xl overflow-hidden border border-slate-700 bg-slate-800">
            <Image src={s.image} alt={s.caption} class="w-full h-auto" />
            <figcaption class="text-slate-400 text-sm px-3 py-2">{s.caption}</figcaption>
          </figure>
        ) : (
          <div class="aspect-video rounded-xl border-2 border-dashed border-slate-700 bg-slate-800/50 flex flex-col items-center justify-center gap-2 p-4 text-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-8 h-8 text-slate-600"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
              />
            </svg>
            <p class="text-slate-500 text-sm font-medium">{s.caption}</p>
            <p class="text-slate-600 text-xs italic">{comingSoonText}</p>
          </div>
        ),
      )}
    </div>
  )
}
